{
  "title": "Referee Stats Scraper Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "league": {
      "title": "League",
      "type": "string",
      "description": "League to scrape.",
      "editor": "select",
      "enum": ["laliga2", "premier-league", "primera-division-argentina"],
      "enumTitles": ["LaLiga 2 (Spain)", "Premier League (England)", "Primera División (Argentina)"],
      "default": "laliga2"
    },
    "season": {
      "title": "Season",
      "type": "string",
      "description": "Season, format YYYY-YYYY.",
      "editor": "textfield",
      "default": "2025-2026"
    },
    "mode": {
      "title": "Mode",
      "type": "string",
      "description": "Data level to extract.",
      "editor": "select",
      "enum": ["profile", "matches", "analytics"],
      "enumTitles": ["Profile (season aggregate)", "Matches (per-match)", "Analytics (derived)"],
      "default": "profile"
    },
    "since": {
      "title": "Since",
      "type": "string",
      "description": "Optional date (YYYY-MM-DD) for incremental scraping — new matches only.",
      "editor": "datepicker"
    }
  },
  "required": ["league", "season", "mode"]
}
